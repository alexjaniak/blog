---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { formatLongDate } from "../../lib/posts";

export async function getStaticPaths() {
	const posts = await getCollection("posts", ({ data }) => !data.draft);
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const tocHeadings = headings.filter((heading) => heading.depth === 2);
const tocItems = [
	{ slug: "post-title", text: post.data.title },
	...tocHeadings.map((heading) => ({ slug: heading.slug, text: heading.text })),
];
const postUrl = new URL(`/blog/${post.id}/`, Astro.site ?? "https://aelix.dev").toString();
const postJsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: post.data.title,
	description: post.data.description,
	datePublished: post.data.date.toISOString(),
	dateModified: post.data.date.toISOString(),
	url: postUrl,
	mainEntityOfPage: postUrl,
	author: {
		"@type": "Person",
		name: "Alex Janiak",
		url: "https://aelix.dev/",
		sameAs: [
			"https://github.com/alexjaniak",
			"https://x.com/aelix0x",
			"https://www.linkedin.com/in/alexander-janiak/",
			"https://www.lesswrong.com/users/alexjaniak",
			"https://substack.com/@aelix0x",
		],
	},
	publisher: {
		"@type": "Person",
		name: "Alex Janiak",
		url: "https://aelix.dev/",
	},
	keywords: post.data.tags,
};
---

<Base title={post.data.title} description={post.data.description} contentClass="content-column post-page-column">
	<script type="application/ld+json" set:html={JSON.stringify(postJsonLd)} />
	<div class="post-layout">
		{
			tocHeadings.length > 0 && (
				<aside class="post-toc" aria-label="Post sections" data-scroll-toc>
					<div class="post-toc-rail" aria-hidden="true">
						<span data-scroll-toc-progress></span>
					</div>
					<nav>
						{tocItems.map((item) => (
							<a href={`#${item.slug}`} data-toc-target={item.slug}>
								<span class="post-toc-marker" aria-hidden="true"></span>
								<span class="post-toc-text">{item.text}</span>
							</a>
						))}
					</nav>
				</aside>
			)
		}
		<article>
			<header class="post-header">
				<h1 id="post-title" class="page-title">{post.data.title}</h1>
				{post.data.description && <p class="subtitle">{post.data.description}</p>}
				<time class="post-date" datetime={post.data.date.toISOString()}>{formatLongDate(post.data.date)}</time>
			</header>
			<div class="post-content">
				<Content />
			</div>
			<div class="post-endmark" aria-hidden="true">*</div>
		</article>
	</div>
	<script>
		const toc = document.querySelector("[data-scroll-toc]");
		const progress = toc?.querySelector("[data-scroll-toc-progress]");
		const links = Array.from(toc?.querySelectorAll("[data-toc-target]") ?? []);
		const headingsById = new Map(
			links
				.map((link) => {
					const id = link.getAttribute("data-toc-target");
					const heading = id ? document.getElementById(id) : null;
					return heading ? [id, heading] : null;
				})
				.filter(Boolean)
		);

		function updateToc() {
			if (!toc || !progress || links.length === 0) return;

			const viewportLine = Math.min(window.innerHeight * 0.38, 320);
			const scrollable = Math.max(
				document.documentElement.scrollHeight - window.innerHeight,
				1
			);
			const tocHeight = toc.clientHeight;
			let activeIndex = 0;

			links.forEach((link, index) => {
				const heading = headingsById.get(link.getAttribute("data-toc-target"));
				const isPassed = heading ? heading.getBoundingClientRect().top <= viewportLine : false;
				const headingTop = heading
					? heading.getBoundingClientRect().top + window.scrollY
					: 0;
				const headingProgress = Math.min(Math.max((headingTop - viewportLine) / scrollable, 0), 1);
				const labelY = Math.min(Math.max(headingProgress * tocHeight, 18), tocHeight - 18);

				link.style.setProperty("--toc-y", `${labelY}px`);
				link.classList.toggle("is-passed", isPassed);
				link.removeAttribute("aria-current");
				if (isPassed) activeIndex = index;
			});

			links.forEach((link, index) => {
				const isActive = index === activeIndex;
				link.classList.toggle("is-active", isActive);
				if (isActive) link.setAttribute("aria-current", "location");
			});

			const progressRatio = Math.min(Math.max(window.scrollY / scrollable, 0), 1);
			progress.style.height = `${progressRatio * tocHeight}px`;
		}

		updateToc();
		window.addEventListener("scroll", updateToc, { passive: true });
		window.addEventListener("resize", updateToc);
		window.addEventListener("load", updateToc);
	</script>
	<script>
		const postContent = document.querySelector(".post-content");
		const footnoteSection = postContent?.querySelector("[data-footnotes]");
		const desktopNotes = window.matchMedia("(min-width: 1280px)");
		let sideNoteLayer;
		let sideNotes = [];

		function getTargetId(anchor) {
			const href = anchor.getAttribute("href");
			return href?.startsWith("#") ? decodeURIComponent(href.slice(1)) : "";
		}

		function makeSideNotes() {
			sideNoteLayer?.remove();
			sideNoteLayer = undefined;
			sideNotes = [];
			postContent?.classList.remove("has-sidenotes");

			if (!postContent || !footnoteSection || !desktopNotes.matches) return;

			const refs = Array.from(postContent.querySelectorAll("[data-footnote-ref]"));
			const seen = new Set();
			sideNoteLayer = document.createElement("aside");
			sideNoteLayer.className = "sidenote-layer";
			sideNoteLayer.setAttribute("aria-hidden", "true");

			refs.forEach((ref) => {
				const noteId = getTargetId(ref);
				if (!noteId || seen.has(noteId)) return;

				const original = document.getElementById(noteId);
				if (!original) return;

				seen.add(noteId);
				const note = original.cloneNode(true);
				note.querySelectorAll("[data-footnote-backref]").forEach((backref) => backref.remove());

				const sideNote = document.createElement("div");
				sideNote.className = "sidenote";
				sideNote.dataset.footnoteId = noteId;
				sideNote.innerHTML = `<span class="sidenote-number">${ref.textContent}</span>${note.innerHTML}`;
				sideNoteLayer.append(sideNote);
				sideNotes.push({ ref, sideNote });
			});

			if (sideNotes.length === 0) return;

			postContent.append(sideNoteLayer);
			postContent.classList.add("has-sidenotes");
			positionSideNotes();
		}

		function positionSideNotes() {
			if (!postContent || !sideNoteLayer || sideNotes.length === 0) return;

			const contentTop = postContent.getBoundingClientRect().top + window.scrollY;
			let previousBottom = 0;

			sideNotes.forEach(({ ref, sideNote }) => {
				const refTop = ref.getBoundingClientRect().top + window.scrollY - contentTop;
				const top = Math.max(refTop - 4, previousBottom + 14);
				sideNote.style.top = `${top}px`;
				previousBottom = top + sideNote.offsetHeight;
			});
		}

		function flashSideNote(ref) {
			if (!desktopNotes.matches) return;

			const noteId = getTargetId(ref);
			const sideNote = sideNotes.find((item) => item.sideNote.dataset.footnoteId === noteId)?.sideNote;
			if (!sideNote) return;

			sideNote.classList.add("is-highlighted");
			window.setTimeout(() => sideNote.classList.remove("is-highlighted"), 900);
		}

		postContent?.addEventListener("click", (event) => {
			const ref = event.target.closest?.("[data-footnote-ref]");
			if (!ref || !desktopNotes.matches) return;

			event.preventDefault();
			flashSideNote(ref);
		});

		makeSideNotes();
		window.addEventListener("resize", () => {
			makeSideNotes();
			positionSideNotes();
		});
		window.addEventListener("load", positionSideNotes);
		document.fonts?.ready.then(positionSideNotes);
	</script>
</Base>
