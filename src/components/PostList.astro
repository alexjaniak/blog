---
import type { CollectionEntry } from "astro:content";
import { formatShortDate } from "../lib/posts";
import TagList from "./TagList.astro";

type Props = {
	posts: CollectionEntry<"posts">[];
};

const { posts } = Astro.props;
---

<ul class="post-list">
	{posts.map((post) => (
		<li class="post-item">
			<div class="post-item-head">
				<span><a class="post-item-title" href={`/blog/${post.id}/`}>{post.data.title}</a>{post.data.draft && <span class="draft-badge">Draft</span>}</span>
				<time class="post-item-date" datetime={post.data.date.toISOString()}>{formatShortDate(post.data.date)}</time>
			</div>
			{post.data.description && <p class="post-item-description">{post.data.description}</p>}
			<TagList tags={post.data.tags} />
		</li>
	))}
</ul>
